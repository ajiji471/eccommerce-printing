APP_NAME="MSVA Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://msva.platform.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=msva_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=gmail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@msva.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform tenancy
PLATFORM_DOMAIN=platform.test
# Host lokal yang dilayani sebagai landing platform (bukan tenant)
PLATFORM_ALIASES=localhost,127.0.0.1,::1

# Super-admin awal (dipakai SuperAdminSeeder)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Admin tenant MSVA (dipakai TenantSeeder)
MSVA_ADMIN_NAME=
MSVA_ADMIN_EMAIL=
MSVA_ADMIN_PASSWORD=

# Admin tenant Demo (dipakai TenantSeeder)
DEMO_ADMIN_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Google Drive (spike F0-08, keputusan akhir di ADR-0001)
GOOGLE_DRIVE_DRIVER=service_account
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Gmail API (F0-09)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER_EMAIL=
GOOGLE_GMAIL_DAILY_QUOTA=500
GMAIL_FAKE=false

# RajaOngkir / Komerce (F0-10)
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
RAJAONGKIR_TIMEOUT=5
RAJAONGKIR_FAKE=false
